# Porta do servidor (opcional, padrão 3000)
PORT=3000

# String de conexão direta com o Postgres do Supabase (Settings > Database)
DATABASE_URL=

# URL do projeto Supabase (Settings > API)
SUPABASE_URL=

# Chave publica/anonima do Supabase (Settings > API)
# Segura para expor no frontend -- mas aqui so eh usada como fallback.
SUPABASE_ANON_KEY=

# Chave de servico do Supabase (Settings > API) -- NUNCA expor no frontend.
# O backend sempre usa esta chave quando ela esta definida (bypassa RLS).
# Sem ela, todo insert/update cai no anon key e eh bloqueado pelas policies
# de RLS ("new row violates row-level security policy").
SUPABASE_SERVICE_ROLE_KEY=
